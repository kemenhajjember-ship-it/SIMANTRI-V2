const elLoket = { 
  checkboxes: Array.from(document.querySelectorAll('input[type="checkbox"][data-loket]')), 
  jumlahAktif: document.getElementById('jumlahLoketAktif') 
};

function perbaruiJumlahLoketAktif() { 
  if (elLoket.jumlahAktif) {
    elLoket.jumlahAktif.textContent = elLoket.checkboxes.filter(cb => cb.checked).length; 
  }
}

if (elLoket.checkboxes.length > 0) {
  onValue(ref(db, 'pengaturan/loket_aktif'), (snap) => { 
    const status = snap.exists() ? snap.val() : {}; 
    elLoket.checkboxes.forEach(cb => { 
      cb.checked = status[cb.dataset.loket] !== undefined ? !!status[cb.dataset.loket] : true; 
    }); 
    perbaruiJumlahLoketAktif(); 
  });

  elLoket.checkboxes.forEach(cb => { 
    cb.addEventListener('change', async () => { 
      try {
        await set(ref(db, `pengaturan/loket_aktif/${cb.dataset.loket}`), cb.checked); 
        perbaruiJumlahLoketAktif(); 
      } catch(e) {
        console.error("Gagal mengupdate status loket", e);
      }
    }); 
  });
}
// =========================================================================

</script>
</body>
</html>
