el.btnPanggilBiometrik.addEventListener('click', async () => {
  el.pesanBiometrik.textContent = ''; el.btnPanggilBiometrik.disabled = true;
  try {
    let rombongan = null, keyRombongan = null, isLemparan = false;
    
    const snapBio = await get(query(ref(db, 'antrean_biometrik'), orderByChild('timestamp')));
    snapBio.forEach(c => { if(!keyRombongan) { rombongan = { nomorAsal: c.val().nomorAsal, jumlahOrang: c.val().jumlahOrang }; keyRombongan = c.key; isLemparan = true; } });
    
    if(!keyRombongan) {
        const snapKiosk = await get(query(ref(db, 'antrean_menunggu'), orderByChild('timestamp')));
        snapKiosk.forEach(c => { if(!keyRombongan && c.val().kategori === 'foto_biometrik') { rombongan = { nomorAsal: c.val().nomor, jumlahOrang: c.val().jumlahOrang }; keyRombongan = c.key; isLemparan = false; } });
    }

    if (!keyRombongan) { el.pesanBiometrik.textContent = 'Tidak ada rombongan yang menunggu.'; el.btnPanggilBiometrik.disabled = false; return; }
    
    const snapKapasitas = await get(ref(db, 'kapasitas_biometrik/saat_ini'));
    const kapasitasSekarang = snapKapasitas.exists() ? snapKapasitas.val() : 0;
    if (kapasitasSekarang + rombongan.jumlahOrang > KAPASITAS_MAKS_BIOMETRIK) {
      tampilkanAlert('⚠️ Kapasitas Ruangan Tidak Mencukupi', `Saat ini: ${kapasitasSekarang} orang\nRombongan berikutnya: ${rombongan.jumlahOrang} orang\nMaksimal ruangan: ${KAPASITAS_MAKS_BIOMETRIK} orang\n\nSilakan tunggu hingga ada jemaah yang keluar ruangan.`);
      el.btnPanggilBiometrik.disabled = false; return;
    }

    if(isLemparan) await remove(ref(db, `antrean_biometrik/${keyRombongan}`));
    else await remove(ref(db, `antrean_menunggu/${keyRombongan}`));

    await runTransaction(ref(db, 'kapasitas_biometrik/saat_ini'), (k) => (k || 0) + rombongan.jumlahOrang);
    const payloadPanggilan = { nomor: rombongan.nomorAsal, loket: 'Ruang Foto Biometrik', kategori: 'foto_biometrik', timestamp: serverTimestamp() };
    await set(ref(db, 'panggilan_aktif'), payloadPanggilan);
    await set(ref(db, 'status_loket/biometrik'), payloadPanggilan);
    nomorBiometrikAktif = rombongan.nomorAsal;
    el.biometrikNomorTampil.textContent = `${rombongan.nomorAsal} (${rombongan.jumlahOrang} org)`;
    el.btnPanggilUlangBiometrik.disabled = false;
    
    await catatAktivitas(rombongan.nomorAsal, 'Panggil', `Dipanggil ke Ruang Foto (${rombongan.jumlahOrang} orang)`, 'foto_biometrik');
  } catch (err) { console.error(err); el.pesanBiometrik.textContent = 'Gagal memanggil rombongan.'; } 
  finally { el.btnPanggilBiometrik.disabled = false; }
});

