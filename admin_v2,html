      <p class="mt-2 text-sm font-medium text-muted-foreground">Tindakan ini akan <span class="font-bold text-bronze-dark">menghapus semua data antrean</span> dan <span class="font-bold text-red-700">tidak dapat dibatalkan.</span></p>
      <input type="text" id="inputKonfirmasiReset" autocomplete="off" class="mt-4 w-full rounded-xl border-2 border-border px-4 py-3 text-center font-mono text-lg font-bold uppercase tracking-widest text-bronze-dark focus:border-red-700 focus:outline-none" placeholder="RESET">
      <p id="pesanErrorReset" class="mt-2 hidden text-xs font-semibold text-red-700">Ketikkan "RESET" (huruf besar) untuk melanjutkan.</p>
      <div class="mt-6 flex gap-3">
        <button type="button" id="btnBatalResetAntrean" class="flex-1 rounded-xl border-2 border-border bg-cream py-3.5 text-sm font-bold text-bronze-dark">Batal</button>
        <button type="button" id="btnKonfirmasiResetAntrean" class="flex-1 rounded-xl bg-red-700 py-3.5 text-sm font-bold text-white shadow-md hover:bg-red-800">Ya, Reset Sekarang</button>
      </div>
    </div>
  </div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getDatabase, ref, get, set, remove, onValue, runTransaction, push, query, orderByChild, limitToFirst, limitToLast, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js";

const firebaseConfig = {
  apiKey: "AIzaSyB7tHB3eRYd-0TGqLlxPsEanymb7qkmDYw",
  authDomain: "simantri-jember.firebaseapp.com",
  databaseURL: "https://simantri-jember-default-rtdb.asia-southeast1.firebasedatabase.app",
  projectId: "simantri-jember",
  storageBucket: "simantri-jember.firebasestorage.app",
  messagingSenderId: "507271630488",
  appId: "1:507271630488:web:dcc347a35334c6f3a84aed"
};
const app = initializeApp(firebaseConfig);
const db = getDatabase(app);

// =========================================================================
// AUTO-RESET ANTREAN DI AWAL HARI
// =========================================================================
const TANGGAL_HARI_INI = new Date().toLocaleDateString('id-ID');
const refTanggal = ref(db, 'pengaturan/tanggal_terakhir');

get(refTanggal).then(async (snap) => {
  if (!snap.exists()) {
    set(refTanggal, TANGGAL_HARI_INI);
  } else if (snap.val() !== TANGGAL_HARI_INI) {
    try {
      await Promise.all([ 
        remove(ref(db, 'counter_nomor')), 
        remove(ref(db, 'antrean_menunggu')), 
        remove(ref(db, 'antrean_biometrik')), 
        remove(ref(db, 'status_loket')), 
        remove(ref(db, 'panggilan_aktif')), 
        set(ref(db, 'kapasitas_biometrik/saat_ini'), 0),
        set(refTanggal, TANGGAL_HARI_INI)
      ]);
      await catatAktivitas('SISTEM', 'Reset', 'Sistem mereset antrean otomatis karena berganti hari.', 'Sistem');
      tampilkanAlert('Hari Baru Dimulai', 'Antrean hari kemarin telah direset secara otomatis. Sistem siap digunakan untuk pelayanan hari ini.');
    } catch(e) { console.error("Gagal Auto-Reset", e); }
  }
});

// =========================================================================
// PEMETAAN LOKET & TARGET LAYANAN (GLOBAL QUEUE)
// =========================================================================
const KONFIGURASI_PERAN = {
  loketA: { nama: "Loket A", target: ["verifikasi", "informasi", "pembatalan", "pelimpahan"], bisaTeruskanBiometrik: true },
  loketB: { nama: "Loket B", target: ["verifikasi", "informasi", "pembatalan", "pelimpahan"], bisaTeruskanBiometrik: true },
  loketC: { nama: "Loket C", target: ["verifikasi", "informasi", "pembatalan", "pelimpahan"], bisaTeruskanBiometrik: true },
  loketD: { nama: "Loket D", target: ["verifikasi", "informasi", "pembatalan", "pelimpahan"], bisaTeruskanBiometrik: true },
  biovisa: { nama: "Ruang Bio Visa", target: ["bio_visa"], bisaTeruskanBiometrik: false },
  biometrik: { nama: "Ruang Foto Biometrik", target: ["foto_biometrik"] }
};

const NAMA_KATEGORI = {
  verifikasi: 'Verifikasi', informasi: 'Informasi', pembatalan: 'Pembatalan',
  pelimpahan: 'Pelimpahan', foto_biometrik: 'Foto Wajah', bio_visa: 'Bio Visa'
};

const KAPASITAS_MAKS_BIOMETRIK = 8;

let peranAktif = null;
let nomorSedangDilayani = null;
let terkunci = false;
let nomorBiometrikAktif = null;
let angkaModalBiometrik = 1;
let angkaModalKeluar = 1;
let statSelesai = 0;
let statBiometrik = 0;
let unsubscribeAntrean = null; 

lucide.createIcons();

const el = {
  pilihPeran: document.getElementById('pilihPeran'),
  jamAdmin: document.getElementById('jamAdmin'),
  panelKosong: document.getElementById('panelKosong'),
  kontenPeran: document.getElementById('kontenPeran'),
  judulKonsol: document.getElementById('judulKonsol'),
  statMenunggu: document.getElementById('statMenunggu'),
  statSelesai: document.getElementById('statSelesai'),
  statBiometrik: document.getElementById('statBiometrik'),
  panelLoket: document.getElementById('panelLoket'),
  nomorSedangDilayaniEl: document.getElementById('nomorSedangDilayani'),
  badgeKategoriLoket: document.getElementById('badgeKategoriLoket'),
  infoWaktuPanggil: document.getElementById('infoWaktuPanggil'),
  statusKunciBadge: document.getElementById('statusKunciBadge'),
  iconKunci: document.getElementById('iconKunci'),
  statusKunciTeks: document.getElementById('statusKunciTeks'),
  statusKunciKeterangan: document.getElementById('statusKunciKeterangan'),
  btnUlangiPengumuman: document.getElementById('btnUlangiPengumuman'),
  baristAksiLoket: document.getElementById('baristAksiLoket'),
  btnPanggilSelanjutnya: document.getElementById('btnPanggilSelanjutnya'),
  btnSelesaiTanpaBiometrik: document.getElementById('btnSelesaiTanpaBiometrik'),
  btnTeruskanBiometrik: document.getElementById('btnTeruskanBiometrik'),
  pesanLoket: document.getElementById('pesanLoket'),
  panelBiometrik: document.getElementById('panelBiometrik'),
  kapasitasSaatIni: document.getElementById('kapasitasSaatIni'),
  kapasitasMaks: document.getElementById('kapasitasMaks'),
  kapasitasBar: document.getElementById('kapasitasBar'),
  biometrikNomorTampil: document.getElementById('biometrikNomorTampil'),
  btnPanggilBiometrik: document.getElementById('btnPanggilBiometrik'),
  btnPanggilUlangBiometrik: document.getElementById('btnPanggilUlangBiometrik'),
  btnSelesaiBiometrik: document.getElementById('btnSelesaiBiometrik'),
  pesanBiometrik: document.getElementById('pesanBiometrik'),
  judulTabelAntrean: document.getElementById('judulTabelAntrean'),
  subJudulTabelAntrean: document.getElementById('subJudulTabelAntrean'),
  isiTabelAntrean: document.getElementById('isiTabelAntrean'),
  daftarAktivitas: document.getElementById('daftarAktivitas'),
  overlayKonfirmasiBiometrik: document.getElementById('overlayKonfirmasiBiometrik'),
  modalBiometrikSub: document.getElementById('modalBiometrikSub'),
  angkaKonfirmasiBiometrik: document.getElementById('angkaKonfirmasiBiometrik'),
  btnKurangBiometrik: document.getElementById('btnKurangBiometrik'),
  btnTambahBiometrik: document.getElementById('btnTambahBiometrik'),
  btnBatalKonfirmasiBiometrik: document.getElementById('btnBatalKonfirmasiBiometrik'),
  btnOkKonfirmasiBiometrik: document.getElementById('btnOkKonfirmasiBiometrik'),
  overlayKeluarBiometrik: document.getElementById('overlayKeluarBiometrik'),
  angkaKeluar: document.getElementById('angkaKeluar'),
  btnKurangKeluar: document.getElementById('btnKurangKeluar'),
  btnTambahKeluar: document.getElementById('btnTambahKeluar'),
  btnBatalKeluar: document.getElementById('btnBatalKeluar'),
  btnOkKeluar: document.getElementById('btnOkKeluar'),
  overlayAlert: document.getElementById('overlayAlert'),
  alertJudul: document.getElementById('alertJudul'),
  alertPesan: document.getElementById('alertPesan'),
  btnTutupAlert: document.getElementById('btnTutupAlert'),
  btnResetAntrean: document.getElementById('btnResetAntrean'),
  overlayResetAntrean: document.getElementById('overlayResetAntrean'),
  inputKonfirmasiReset: document.getElementById('inputKonfirmasiReset'),
  pesanErrorReset: document.getElementById('pesanErrorReset'),
  btnBatalResetAntrean: document.getElementById('btnBatalResetAntrean'),
  btnKonfirmasiResetAntrean: document.getElementById('btnKonfirmasiResetAntrean'),
};

el.kapasitasMaks.textContent = KAPASITAS_MAKS_BIOMETRIK;
function perbaruiJam(){ el.jamAdmin.textContent = new Date().toLocaleTimeString('id-ID', { hour12:false }); }
perbaruiJam(); setInterval(perbaruiJam, 1000);

function tampilkanAlert(judul, pesan){
  el.alertJudul.textContent = judul; el.alertPesan.textContent = pesan;
  el.overlayAlert.classList.remove('hidden'); el.overlayAlert.classList.add('flex');
}
el.btnTutupAlert.addEventListener('click', () => { el.overlayAlert.classList.add('hidden'); el.overlayAlert.classList.remove('flex'); });

async function catatAktivitas(nomor, aksi, catatan, kategori = null){
  try {
    await push(ref(db, 'log_aktivitas'), { 
      nomor: nomor, aksi: aksi, catatan: catatan, kategori: kategori || 'Umum',
      waktu: new Date().toLocaleTimeString('id-ID', { hour:'2-digit', minute:'2-digit' }), 
      timestamp: Date.now() 
    });
  } catch(e) { console.error("Gagal mencatat log", e); }
}

const IKON_AKSI = { Selesai:'check', Biometrik:'fingerprint', Panggil:'phone-call' };
onValue(query(ref(db, 'log_aktivitas'), limitToLast(12)), (snap) => {
  const items = []; snap.forEach(child => items.unshift(child.val()));
  el.daftarAktivitas.innerHTML = items.length ? '' : '<li class="px-5 py-4 text-xs text-muted-foreground">Belum ada aktivitas.</li>';
  items.forEach(item => {
    const li = document.createElement('li'); li.className = 'flex items-start gap-3 px-5 py-3';
    li.innerHTML = `<span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-border bg-cream text-bronze"><i data-lucide="${IKON_AKSI[item.aksi] || 'check'}" class="h-3.5 w-3.5"></i></span><div class="min-w-0 flex-1"><div class="flex items-center justify-between gap-2"><span class="font-mono text-sm font-semibold text-bronze-dark">${item.nomor}</span><span class="font-mono text-[11px] text-muted-foreground">${item.waktu}</span></div><p class="truncate text-xs text-muted-foreground">${item.catatan}</p></div>`;
    el.daftarAktivitas.appendChild(li);
  });
  lucide.createIcons();
});

el.pilihPeran.addEventListener('change', async () => {
  peranAktif = el.pilihPeran.value || null;
  nomorSedangDilayani = null; nomorBiometrikAktif = null;
  aturKunciLoket(false);

  el.panelKosong.classList.toggle('hidden', !!peranAktif);
  el.kontenPeran.classList.toggle('hidden', !peranAktif);
  el.kontenPeran.classList.toggle('flex', !!peranAktif);
  el.panelLoket.classList.add('hidden'); el.panelBiometrik.classList.add('hidden');

  if (!peranAktif) {
    if (typeof unsubscribeAntrean === 'function') { unsubscribeAntrean(); unsubscribeAntrean = null; }
    return;
  }

  const konfig = KONFIGURASI_PERAN[peranAktif];
  el.judulKonsol.textContent = `Konsol Petugas ${konfig.nama}`;

  if (peranAktif === 'biometrik') {
    el.panelBiometrik.classList.remove('hidden');
    el.judulTabelAntrean.textContent = 'Rombongan Menunggu di Depan Ruang Foto';
    el.biometrikNomorTampil.textContent = '—';
    el.btnPanggilUlangBiometrik.disabled = true;
    dengarkanAntreanBiometrik();

    try {
      const snapStatus = await get(ref(db, `status_loket/biometrik`));
      if (peranAktif === el.pilihPeran.value && snapStatus.exists() && snapStatus.val().sedangDilayani) {
        nomorBiometrikAktif = snapStatus.val().nomor;
        el.biometrikNomorTampil.textContent = `${nomorBiometrikAktif} (Dipulihkan)`;
        el.btnPanggilUlangBiometrik.disabled = false;
      }
    } catch (err) {}
  } else {
    // Berlaku untuk Loket A, B, C, D, dan Bio Visa
    el.panelLoket.classList.remove('hidden');
    el.nomorSedangDilayaniEl.textContent = '—';
    el.badgeKategoriLoket.textContent = `Melayani: ${konfig.target.map(t => NAMA_KATEGORI[t]).join(' & ')}`;
    el.infoWaktuPanggil.textContent = '';
    
    el.btnTeruskanBiometrik.classList.toggle('hidden', !konfig.bisaTeruskanBiometrik);
    if (!konfig.bisaTeruskanBiometrik) el.baristAksiLoket.classList.replace('md:grid-cols-3', 'md:grid-cols-2');
    else el.baristAksiLoket.classList.replace('md:grid-cols-2', 'md:grid-cols-3');
    
    el.judulTabelAntrean.textContent = `Antrean Menunggu — Target ${konfig.nama}`;
    dengarkanAntreanLoket(konfig.target);

    try {
      const snapStatus = await get(ref(db, `status_loket/${peranAktif}`));
      if (peranAktif === el.pilihPeran.value && snapStatus.exists() && snapStatus.val().sedangDilayani) {
        const dataStatus = snapStatus.val();
        nomorSedangDilayani = { nomor: dataStatus.nomor, kategori: dataStatus.kategori, jumlahOrang: dataStatus.jumlahOrang || 1 };
        el.nomorSedangDilayaniEl.textContent = dataStatus.nomor;
        el.infoWaktuPanggil.textContent = 'Panggilan dipulihkan otomatis';
        aturKunciLoket(true);
      }
    } catch (err) {}
  }
  lucide.createIcons();
});

onValue(ref(db, 'pengaturan/loket_aktif'), (snap) => {
  const status = snap.exists() ? snap.val() : {};
  Array.from(el.pilihPeran.options).forEach((opt) => {
    if (!opt.value) return; // Hanya mengecualikan pilihan kosong pertama
    const aktif = status[opt.value] !== undefined ? !!status[opt.value] : true;
    opt.disabled = !aktif; opt.textContent = opt.textContent.replace(/ \(Tutup\)$/, '') + (aktif ? '' : ' (Tutup)');
  });
  if (peranAktif && status[peranAktif] === false) {
    tampilkanAlert('Sesi Diakhiri', `${KONFIGURASI_PERAN[peranAktif]?.nama || 'Loket ini'} dinonaktifkan.`);
    document.getElementById('btnKeluarSesi').click();
  }
});

function dengarkanAntreanLoket(targetArray){
  if (typeof unsubscribeAntrean === 'function') { unsubscribeAntrean(); unsubscribeAntrean = null; }
  unsubscribeAntrean = onValue(ref(db, 'antrean_menunggu'), (snap) => {
    const items = [];
    snap.forEach(c => { const val = c.val(); if(targetArray.includes(val.kategori)) items.push({...val, key: c.key}); });
    items.sort((a,b) => a.timestamp - b.timestamp);
    
    el.statMenunggu.textContent = items.length;
    el.subJudulTabelAntrean.textContent = `${items.length} nomor dalam daftar tunggu`;
    el.isiTabelAntrean.innerHTML = items.length ? '' : `<tr><td colspan="3" class="px-5 py-6 text-center text-xs text-muted-foreground">Belum ada antrean menunggu.</td></tr>`;
    
    items.forEach((item, i) => {
      const tr = document.createElement('tr'); tr.className = i % 2 === 1 ? 'bg-cream/60' : 'bg-white';
      tr.innerHTML = `<td class="px-5 py-2.5"><span class="font-mono text-sm font-semibold text-bronze-dark">${item.nomor}</span>${i===0 ? '<span class="ml-2 text-[10px] font-semibold uppercase tracking-wider text-gold-dark">Berikutnya</span>' : ''}</td><td class="px-5 py-2.5 text-xs text-muted-foreground">${item.jumlahOrang || 1} org &middot; ${NAMA_KATEGORI[item.kategori]}</td><td class="px-5 py-2.5 text-right text-xs text-muted-foreground">Menunggu</td>`;
      el.isiTabelAntrean.appendChild(tr);
    });
  });
}

function dengarkanAntreanBiometrik(){
  if (typeof unsubscribeAntrean === 'function') { unsubscribeAntrean(); unsubscribeAntrean = null; }
  let unsub1 = null, unsub2 = null;
  let dataLemparan = [], dataLangsung = [];
  
  const renderGabungan = () => {
     const items = [...dataLemparan, ...dataLangsung].sort((a,b) => a.timestamp - b.timestamp);
     el.statMenunggu.textContent = items.length;
     el.subJudulTabelAntrean.textContent = `${items.length} rombongan dalam daftar tunggu`;
     el.isiTabelAntrean.innerHTML = items.length ? '' : `<tr><td colspan="3" class="px-5 py-6 text-center text-xs text-muted-foreground">Belum ada rombongan menunggu.</td></tr>`;
     items.forEach((item, i) => {
      const tr = document.createElement('tr'); tr.className = i % 2 === 1 ? 'bg-cream/60' : 'bg-white';
      tr.innerHTML = `<td class="px-5 py-2.5"><span class="font-mono text-sm font-semibold text-bronze-dark">${item.nomor}</span></td><td class="px-5 py-2.5 text-xs text-muted-foreground">${item.jumlahOrang} org</td><td class="px-5 py-2.5 text-right text-xs text-muted-foreground">${item.asalLoket || 'Kiosk'}</td>`;
      el.isiTabelAntrean.appendChild(tr);
    });
  };

  unsub1 = onValue(ref(db, 'antrean_biometrik'), snap => {
     dataLemparan = []; snap.forEach(c => dataLemparan.push({...c.val(), nomor: c.val().nomorAsal, key: c.key, isLemparan: true})); renderGabungan();
  });
  unsub2 = onValue(ref(db, 'antrean_menunggu'), snap => {
     dataLangsung = []; snap.forEach(c => { if(c.val().kategori === 'foto_biometrik') dataLangsung.push({...c.val(), key: c.key, isLemparan: false}); }); renderGabungan();
  });
  unsubscribeAntrean = () => { if(unsub1) unsub1(); if(unsub2) unsub2(); };
}

function aturKunciLoket(kunci){
  terkunci = kunci;
  el.btnPanggilSelanjutnya.disabled = kunci; el.btnSelesaiTanpaBiometrik.disabled = !kunci; el.btnTeruskanBiometrik.disabled = !kunci;
  el.statusKunciBadge.className = `inline-flex items-center gap-2.5 rounded-full border-2 px-4 py-2 text-xs font-semibold uppercase tracking-wider ${kunci ? 'border-gold bg-bronze text-gold' : 'border-cream/30 bg-cream/10 text-cream'}`;
  el.iconKunci.innerHTML = `<i data-lucide="${kunci ? 'lock' : 'unlock'}" class="h-4 w-4"></i>`;
  el.statusKunciTeks.textContent = kunci ? 'Status Terkunci · Force Action' : 'Status Aktif';
  el.statusKunciKeterangan.textContent = kunci ? 'Loket dikunci. Wajib tekan "Selesai" atau "Teruskan" sebelum lanjut.' : 'Loket aktif dan siap menerima antrean.';
  lucide.createIcons();
}

el.btnPanggilSelanjutnya.addEventListener('click', async () => {
  if (!peranAktif || peranAktif === 'biometrik' || terkunci) return;
  const konfig = KONFIGURASI_PERAN[peranAktif];
  el.btnPanggilSelanjutnya.disabled = true;
  try {
    const snap = await get(query(ref(db, 'antrean_menunggu'), orderByChild('timestamp')));
    let tiket = null, keyTiket = null;
    snap.forEach(child => { if (!keyTiket && konfig.target.includes(child.val().kategori)) { tiket = child.val(); keyTiket = child.key; } });
    
    if (!keyTiket) { tampilkanAlert('Antrean Kosong', `Tidak ada antrean yang sesuai target ${konfig.nama}.`); el.btnPanggilSelanjutnya.disabled = false; return; }
    
    await remove(ref(db, `antrean_menunggu/${keyTiket}`));
    const payloadPanggilan = { nomor: tiket.nomor, loket: konfig.nama, kategori: tiket.kategori, jumlahOrang: tiket.jumlahOrang || 1, sedangDilayani: true, timestamp: serverTimestamp() };
    await set(ref(db, 'panggilan_aktif'), payloadPanggilan);
    await set(ref(db, `status_loket/${peranAktif}`), payloadPanggilan);
    
    nomorSedangDilayani = { nomor: tiket.nomor, kategori: tiket.kategori, jumlahOrang: tiket.jumlahOrang || 1 };
    el.nomorSedangDilayaniEl.textContent = tiket.nomor;
    el.infoWaktuPanggil.textContent = `Dipanggil ${new Date().toLocaleTimeString('id-ID', { hour:'2-digit', minute:'2-digit' })}`;
    aturKunciLoket(true);
    
    await catatAktivitas(tiket.nomor, 'Panggil', `Dipanggil ke ${konfig.nama}`, tiket.kategori);
  } catch (err) { console.error(err); tampilkanAlert('Gagal', 'Koneksi terputus.'); } 
  finally { el.btnPanggilSelanjutnya.disabled = false; }
});

el.btnUlangiPengumuman.addEventListener('click', async () => {
  if (!nomorSedangDilayani || !peranAktif) return;
  await set(ref(db, 'panggilan_aktif'), { nomor: nomorSedangDilayani.nomor, loket: KONFIGURASI_PERAN[peranAktif].nama, kategori: nomorSedangDilayani.kategori, timestamp: serverTimestamp() });
});

el.btnSelesaiTanpaBiometrik.addEventListener('click', async () => {
  el.pesanLoket.textContent = `Layanan untuk ${nomorSedangDilayani?.nomor || '-'} telah selesai.`;
  statSelesai++; el.statSelesai.textContent = statSelesai;
  await catatAktivitas(nomorSedangDilayani?.nomor || '-', 'Selesai', 'Layanan selesai di loket', nomorSedangDilayani?.kategori);
  resetSetelahSelesai();
});

function resetSetelahSelesai(){
  if (peranAktif && peranAktif !== 'biometrik') set(ref(db, `status_loket/${peranAktif}/sedangDilayani`), false).catch(()=>{});
  nomorSedangDilayani = null; el.nomorSedangDilayaniEl.textContent = '—'; el.infoWaktuPanggil.textContent = '';
  aturKunciLoket(false);
}

el.btnTeruskanBiometrik.addEventListener('click', () => {
  if (!nomorSedangDilayani) return;
  angkaModalBiometrik = nomorSedangDilayani.jumlahOrang || 1; el.angkaKonfirmasiBiometrik.textContent = angkaModalBiometrik;
  el.modalBiometrikSub.textContent = `Nomor ${nomorSedangDilayani.nomor} — konfirmasi jumlah orang`;
  el.overlayKonfirmasiBiometrik.classList.remove('hidden'); el.overlayKonfirmasiBiometrik.classList.add('flex');
});
el.btnKurangBiometrik.addEventListener('click', () => { angkaModalBiometrik = Math.max(1, angkaModalBiometrik - 1); el.angkaKonfirmasiBiometrik.textContent = angkaModalBiometrik; });
el.btnTambahBiometrik.addEventListener('click', () => { angkaModalBiometrik = Math.min(KAPASITAS_MAKS_BIOMETRIK, angkaModalBiometrik + 1); el.angkaKonfirmasiBiometrik.textContent = angkaModalBiometrik; });
