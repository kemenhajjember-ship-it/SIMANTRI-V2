let logRiwayat = [];
const LABEL_STATUS = { Panggil: { teks: 'Dipanggil', kelas: 'border-gold/50 bg-gold/15 text-gold-dark' }, Selesai: { teks: 'Selesai', kelas: 'border-emerald-600/30 bg-emerald-50 text-emerald-700' }, Biometrik: { teks: 'Diteruskan', kelas: 'border-bronze/30 bg-cream text-bronze' }, Reset: { teks: 'Sistem', kelas: 'border-red-600/30 bg-red-50 text-red-700' } };

function jenisLayananDariRiwayat(item){ return NAMA_KATEGORI[item.kategori] ? NAMA_KATEGORI[item.kategori] : (item.kategori || '—'); }

function cocokPeriode(item, periode){
  if (periode === 'semua') return true;
  const ts = typeof item.timestamp === 'number' ? item.timestamp : Date.now();
  const dateItem = new Date(ts); const dateNow = new Date();
  if (periode === 'hari-ini') return dateItem.getDate() === dateNow.getDate() && dateItem.getMonth() === dateNow.getMonth() && dateItem.getFullYear() === dateNow.getFullYear();
  if (periode === 'kemarin') { const yesterday = new Date(); yesterday.setDate(yesterday.getDate() - 1); return dateItem.getDate() === yesterday.getDate() && dateItem.getMonth() === yesterday.getMonth() && dateItem.getFullYear() === yesterday.getFullYear(); }
  return true;
}

const elRiwayat = { periode: document.getElementById('filterPeriode'), status: document.getElementById('filterStatus'), cari: document.getElementById('cariNomorRiwayat'), reset: document.getElementById('btnResetFilterRiwayat'), unduh: document.getElementById('btnUnduhRiwayat'), isi: document.getElementById('isiTabelRiwayat'), info: document.getElementById('infoJumlahRiwayat') };

function renderRiwayat(){
  const data = logRiwayat.filter(item => {
    if (!cocokPeriode(item, elRiwayat.periode.value)) return false;
    if (elRiwayat.status.value !== 'semua' && (LABEL_STATUS[item.aksi]?.teks || item.aksi) !== elRiwayat.status.value) return false;
    if (elRiwayat.cari.value && !String(item.nomor || '').toUpperCase().includes(elRiwayat.cari.value.trim().toUpperCase())) return false;
    return true;
  });
  elRiwayat.info.textContent = `${data.length} catatan pemanggilan ditampilkan`;
  if (!data.length){ elRiwayat.isi.innerHTML = `<tr><td colspan="5" class="px-6 py-14 text-center text-xs text-muted-foreground">Tidak ada catatan yang cocok dengan filter.</td></tr>`; return; }
  elRiwayat.isi.innerHTML = data.map((item, i) => {
    const badge = LABEL_STATUS[item.aksi] || { teks: item.aksi || '—', kelas: 'border-border bg-cream text-bronze' };
    return `<tr class="${i % 2 === 1 ? 'bg-cream/35' : 'bg-white'} transition-colors hover:bg-cream/70"><td class="px-6 py-3.5 font-mono text-sm text-bronze-dark">${item.waktu || '--:--'}</td><td class="px-6 py-3.5"><span class="font-mono text-sm font-bold text-bronze-dark">${item.nomor || '—'}</span></td><td class="px-6 py-3.5 text-xs font-medium text-muted-foreground">${jenisLayananDariRiwayat(item)}</td><td class="px-6 py-3.5 text-xs font-semibold text-bronze">${(item.catatan || '').split(' ke ')[1] || '—'}</td><td class="px-6 py-3.5 text-right"><span class="inline-flex items-center rounded-full border px-3 py-1 text-[11px] font-semibold ${badge.kelas}">${badge.teks}</span></td></tr>`;
  }).join('');
}

[elRiwayat.periode, elRiwayat.status].forEach(node => node.addEventListener('change', renderRiwayat)); elRiwayat.cari.addEventListener('input', renderRiwayat);
elRiwayat.reset.addEventListener('click', () => { elRiwayat.periode.value = 'hari-ini'; elRiwayat.status.value = 'semua'; elRiwayat.cari.value = ''; renderRiwayat(); });
elRiwayat.unduh.addEventListener('click', () => {
  const baris = [['Waktu Panggil','Nomor Antrean','Jenis Layanan','Loket','Status']].concat(riwayatTersaring().map(item => [ item.waktu || '', item.nomor || '', jenisLayananDariRiwayat(item), (item.catatan || '').split(' ke ')[1] || '—', LABEL_STATUS[item.aksi]?.teks || item.aksi || '' ]));
  const csv = baris.map(r => r.map(v => `"${String(v).replace(/"/g,'""')}"`).join(',')).join('\n');
  const url = URL.createObjectURL(new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' }));
  const a = document.createElement('a'); a.href = url; a.download = `riwayat-antrean-${new Date().toISOString().slice(0,10)}.csv`;
  a.click(); URL.revokeObjectURL(url);
});

const elLaporan = { periode: document.getElementById('filterPeriodeLaporan'), totalPengunjung: document.getElementById('lapTotalPengunjung'), rataTunggu: document.getElementById('lapRataTunggu'), loketTersibuk: document.getElementById('lapLoketTersibuk'), loketSub: document.getElementById('lapLoketTersibukSub'), totalBiometrik: document.getElementById('lapTotalBiometrik'), wadahKomposisi: document.getElementById('wadahKomposisiLayanan'), jamTersibuk: document.getElementById('lapJamTersibuk') };

function renderLaporan(){
  const data = logRiwayat.filter(item => cocokPeriode(item, elLaporan.periode.value));
  const panggilan = data.filter(item => item.aksi === 'Panggil');
  elLaporan.totalPengunjung.textContent = panggilan.length;
  elLaporan.totalBiometrik.textContent = data.filter(item => item.aksi === 'Biometrik').length;

  const stempel = panggilan.map(i => i.timestamp).filter(t => typeof t === 'number').sort((a,b) => a - b);
  elLaporan.rataTunggu.textContent = (stempel.length > 1) ? Math.round((stempel[stempel.length - 1] - stempel[0]) / (stempel.length - 1) / 60000) : 0;

  const perLoket = {}; panggilan.forEach(i => { const loket = (i.catatan || '').split(' ke ')[1]; if (loket) perLoket[loket] = (perLoket[loket] || 0) + 1; });
  const urutLoket = Object.entries(perLoket).sort((a,b) => b[1] - a[1]);
  elLaporan.loketTersibuk.textContent = urutLoket.length ? urutLoket[0][0] : '—'; elLaporan.loketSub.textContent = urutLoket.length ? `${urutLoket[0][1]} nomor dilayani` : 'belum ada data';

  if (elLaporan.wadahKomposisi) {
    elLaporan.wadahKomposisi.innerHTML = '';
    const rekapKat = {}; panggilan.forEach(p => { const k = p.kategori || 'Umum'; rekapKat[k] = (rekapKat[k] || 0) + 1; });
    Object.entries(NAMA_KATEGORI).forEach(([key, name]) => {
        const jumlah = rekapKat[key] || 0; const persen = panggilan.length ? Math.round((jumlah / panggilan.length) * 100) : 0;
        if (jumlah > 0 || panggilan.length === 0) {
          elLaporan.wadahKomposisi.innerHTML += `<div><div class="flex items-baseline justify-between"><p class="text-xs font-semibold text-bronze-dark">${name}</p><p class="font-mono text-xs font-bold text-bronze-dark">${persen}%</p></div><div class="mt-2 h-2.5 overflow-hidden rounded-full bg-cream"><div class="h-full rounded-full bg-gold transition-all" style="width:${persen}%"></div></div><p class="mt-1.5 text-[11px] text-muted-foreground">${jumlah} nomor</p></div>`;
        }
    });
  }

  const perJam = {}; panggilan.forEach(i => { const jam = String(i.waktu || '').slice(0, 2); if (/^\d\d$/.test(jam)) perJam[jam] = (perJam[jam] || 0) + 1; });
  const urutJam = Object.entries(perJam).sort((a,b) => b[1] - a[1]);
  elLaporan.jamTersibuk.textContent = urutJam.length ? `${urutJam[0][0]}.00 — ${urutJam[0][0]}.59` : '—';
  if(typeof perbaruiChartKunjungan === 'function') perbaruiChartKunjungan(perJam);
}
elLaporan.periode.addEventListener('change', renderLaporan);

