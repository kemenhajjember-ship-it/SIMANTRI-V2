<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SIMANTRI V2 — Konsol Petugas</title>

<script src="https://code.responsivevoice.org/responsivevoice.js"></script>
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          bronze: '#3d2817',
          'bronze-dark': '#2b1b10',
          'bronze-soft': '#6b5340',
          gold: '#d4af37',
          'gold-dark': '#b8860b',
          cream: '#f5eee0',
          background: '#faf7f2',
          border: '#e7dcc8',
          'muted-foreground': '#7a6652',
        },
        fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
      },
    },
  };
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
<script src="https://unpkg.com/lucide@latest"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<style> body{ font-variant-numeric: tabular-nums; } </style>
</head>
<body class="flex h-dvh flex-col overflow-hidden bg-background font-sans text-bronze-dark">

  <header class="flex h-16 shrink-0 items-center gap-6 bg-bronze-dark px-6 text-cream">
    <div class="flex items-center gap-3">
      <img src="logo.png" alt="Logo Instansi" class="h-10 w-10 rounded-full border border-gold/40 object-cover">
      <div class="leading-tight">
        <p class="text-sm font-semibold tracking-[0.18em] text-gold">SIMANTRI V2</p>
        <p class="text-[11px] text-cream/60">Sistem Antrean Global &middot; Kemenhaj Jember</p>
      </div>
    </div>

    <div class="ml-auto flex items-center gap-3">
      <div class="flex items-center gap-2 rounded-lg bg-bronze/70 px-3 py-2">
        <i data-lucide="clock" class="h-4 w-4 text-gold"></i>
        <span id="jamAdmin" class="font-mono text-sm">--:--:--</span>
      </div>
      <div class="h-8 w-px bg-cream/15"></div>
      <div class="flex items-center gap-3">
        <select id="pilihPeran" class="rounded-lg border border-gold/40 bg-bronze px-3 py-2 text-sm font-semibold text-cream focus:outline-none">
          <option value="">— Pilih Akses Login —</option>
          <option value="loketA">Loket A (Pak Samhadi)</option>
          <option value="loketB">Loket B (Pak Wahib)</option>
          <option value="loketC">Loket C (Bu Yanti)</option>
          <option value="loketD">Loket D (Pak Irvan)</option>
          <option value="biometrik">Ruang Foto Biometrik</option>
          <option value="biovisa">Ruang Bio Visa</option>
        </select>
        <div class="flex h-9 w-9 items-center justify-center rounded-full border border-gold/40 bg-bronze">
          <i data-lucide="user-round" class="h-4 w-4 text-gold"></i>
        </div>
      </div>
    </div>
  </header>

  <div class="flex min-h-0 flex-1">
    <nav aria-label="Navigasi utama" class="flex w-20 shrink-0 flex-col items-center gap-2 bg-bronze-dark py-5">
      <button type="button" data-view="dashboard" title="Dashboard" class="group relative flex h-14 w-14 flex-col items-center justify-center gap-1 rounded-xl bg-gold text-bronze-dark">
        <span class="absolute -left-3 top-1/2 h-8 w-1 -translate-y-1/2 rounded-r-full bg-gold"></span>
        <i data-lucide="layout-dashboard" class="h-5 w-5"></i>
        <span class="text-[9px] font-medium leading-none">Dashboard</span>
      </button>
      <button type="button" data-view="riwayat" title="Riwayat Antrean" class="flex h-14 w-14 flex-col items-center justify-center gap-1 rounded-xl text-cream/55 transition-colors hover:bg-bronze hover:text-cream">
        <span class="absolute -left-3 top-1/2 hidden h-8 w-1 -translate-y-1/2 rounded-r-full bg-gold"></span>
        <i data-lucide="history" class="h-5 w-5"></i>
        <span class="text-[9px] font-medium leading-none">Riwayat</span>
      </button>
      <button type="button" data-view="laporan" title="Laporan" class="flex h-14 w-14 flex-col items-center justify-center gap-1 rounded-xl text-cream/55 transition-colors hover:bg-bronze hover:text-cream">
        <span class="absolute -left-3 top-1/2 hidden h-8 w-1 -translate-y-1/2 rounded-r-full bg-gold"></span>
        <i data-lucide="file-bar-chart" class="h-5 w-5"></i>
        <span class="text-[9px] font-medium leading-none">Laporan</span>
      </button>
      <button type="button" data-view="atur" title="Pengaturan" class="flex h-14 w-14 flex-col items-center justify-center gap-1 rounded-xl text-cream/55 transition-colors hover:bg-bronze hover:text-cream">
        <span class="absolute -left-3 top-1/2 hidden h-8 w-1 -translate-y-1/2 rounded-r-full bg-gold"></span>
        <i data-lucide="settings" class="h-5 w-5"></i>
        <span class="text-[9px] font-medium leading-none">Atur</span>
      </button>
      
      <button type="button" id="btnResetAntrean" title="Reset Antrean Hari Ini" class="mt-auto flex h-14 w-14 flex-col items-center justify-center gap-1 rounded-xl border border-red-900/40 bg-red-900/20 text-red-400 transition-colors hover:bg-red-700 hover:text-white">
        <i data-lucide="refresh-ccw" class="h-5 w-5"></i>
        <span class="text-[9px] font-semibold leading-none">Reset</span>
      </button>

      <button type="button" id="btnKeluarSesi" title="Keluar" class="flex h-14 w-14 flex-col items-center justify-center gap-1 rounded-xl text-cream/45 transition-colors hover:bg-bronze hover:text-cream">
        <i data-lucide="log-out" class="h-5 w-5"></i>
        <span class="text-[9px] font-medium leading-none">Keluar</span>
      </button>
    </nav>

    <main class="min-w-0 flex-1 overflow-y-auto px-6 py-5">
      <div class="mx-auto flex w-full max-w-[1600px] flex-col gap-5 xl:max-w-[95%]">

        <!-- ==================== VIEW: DASHBOARD ==================== -->
        <div id="viewDashboard" class="flex flex-col gap-5">
          <div id="panelKosong" class="rounded-2xl border border-border bg-white px-6 py-16 text-center text-muted-foreground">
            👋 Silakan pilih akses login di pojok kanan atas untuk mulai bertugas.
          </div>

          <div id="kontenPeran" class="hidden flex-col gap-5">
            <div>
              <h1 id="judulKonsol" class="text-lg font-semibold text-bronze-dark">Konsol Petugas Loket</h1>
              <p class="text-sm text-muted-foreground">Kelola pemanggilan antrean layanan Haji dan Umrah</p>
            </div>

            <section aria-label="Ringkasan sesi" class="grid grid-cols-2 gap-3 xl:grid-cols-3">
              <div class="rounded-xl border border-border bg-white px-4 py-3 shadow-[0_1px_2px_rgba(61,40,23,0.06)]">
                <p class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">Menunggu di Antrean</p>
                <div class="mt-1 flex items-baseline gap-2">
                  <span id="statMenunggu" class="text-xl font-semibold text-bronze-dark">0</span>
                  <span class="text-[11px] text-muted-foreground">kategori ini</span>
                </div>
              </div>
              <div class="rounded-xl border border-border bg-white px-4 py-3 shadow-[0_1px_2px_rgba(61,40,23,0.06)]">
                <p class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">Selesai Sesi Ini</p>
                <div class="mt-1 flex items-baseline gap-2">
                  <span id="statSelesai" class="text-xl font-semibold text-bronze-dark">0</span>
                  <span class="text-[11px] text-muted-foreground">nomor</span>
                </div>
              </div>
              <div class="rounded-xl border border-border bg-white px-4 py-3 shadow-[0_1px_2px_rgba(61,40,23,0.06)]">
                <p class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">Diteruskan Biometrik</p>
                <div class="mt-1 flex items-baseline gap-2">
                  <span id="statBiometrik" class="text-xl font-semibold text-bronze-dark">0</span>
                  <span class="text-[11px] text-muted-foreground">sesi ini</span>
                </div>
              </div>
            </section>

            <div class="grid gap-5 xl:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
              <div class="flex flex-col gap-5">
                <section id="panelLoket" class="hidden overflow-hidden rounded-2xl border border-border bg-white shadow-[0_2px_8px_rgba(61,40,23,0.08)]">
                  <div class="relative bg-bronze-dark px-7 py-6">
                    <div class="flex flex-wrap items-start justify-between gap-6">
                      <div>
                        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-cream/55">Nomor Sedang Dilayani</p>
                        <p id="nomorSedangDilayani" class="mt-2 font-mono text-7xl font-bold leading-none tracking-tight text-gold">—</p>
                        <div class="mt-4 flex flex-wrap items-center gap-2.5">
                          <span id="badgeKategoriLoket" class="inline-flex items-center rounded-md border border-gold/45 bg-gold/15 px-2.5 py-1 text-xs font-semibold text-gold">—</span>
                          <span id="infoWaktuPanggil" class="text-xs text-cream/65"></span>
                        </div>
                      </div>
                      <div class="flex flex-col items-end gap-3">
                        <span id="statusKunciBadge" class="inline-flex items-center gap-2.5 rounded-full border-2 border-cream/30 bg-cream/10 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-cream">
                          <span id="iconKunci" class="inline-flex h-4 w-4 items-center justify-center"><i data-lucide="unlock" class="h-4 w-4"></i></span>
                          <span id="statusKunciTeks">Status Aktif</span>
                        </span>
                        <p id="statusKunciKeterangan" class="max-w-[16rem] text-right text-[11px] leading-relaxed text-cream/55">Loket aktif dan siap menerima nomor antrean berikutnya.</p>
                        <button type="button" id="btnUlangiPengumuman" class="inline-flex items-center gap-1.5 rounded-lg border border-cream/20 px-3 py-1.5 text-[11px] font-medium text-cream/80 transition-colors hover:bg-cream/10">
                          <i data-lucide="volume-2" class="h-3.5 w-3.5"></i> Ulangi Pengumuman
                        </button>
                      </div>
                    </div>
                  </div>
                  <div id="baristAksiLoket" class="grid gap-3 px-7 py-6 md:grid-cols-3">
                    <button type="button" id="btnPanggilSelanjutnya" class="flex h-16 items-center justify-center gap-2.5 rounded-xl bg-gold px-2 text-sm font-bold uppercase tracking-wide text-bronze-dark shadow-[0_2px_0_#b8860b] transition-all hover:brightness-105 active:translate-y-0.5 active:shadow-none disabled:cursor-not-allowed disabled:opacity-45 disabled:shadow-none">
                      <i data-lucide="phone-call" class="h-5 w-5 shrink-0"></i> 
                      <span class="text-left leading-tight">Panggil<br>Selanjutnya</span>
                    </button>
                    <button type="button" id="btnSelesaiTanpaBiometrik" disabled class="flex h-16 items-center justify-center gap-2.5 rounded-xl border-2 border-bronze bg-white px-2 text-sm font-bold uppercase tracking-wide text-bronze transition-colors hover:bg-cream active:bg-cream disabled:cursor-not-allowed disabled:opacity-40">
                      <i data-lucide="check" class="h-5 w-5 shrink-0"></i> 
                      <span>Selesai</span>
                    </button>
                    <button type="button" id="btnTeruskanBiometrik" disabled class="flex h-16 items-center justify-center gap-2.5 rounded-xl bg-bronze px-2 text-sm font-bold uppercase tracking-wide text-gold transition-colors hover:bg-bronze-dark active:bg-bronze-dark disabled:cursor-not-allowed disabled:opacity-40">
                      <i data-lucide="fingerprint" class="h-5 w-5 shrink-0"></i> 
                      <span class="text-left leading-tight">Teruskan Ke<br>Biometrik</span>
                    </button>
                  </div>
                  <div class="flex items-center gap-2 border-t border-border bg-cream/50 px-7 py-3 text-[11px] text-muted-foreground">
                    <i data-lucide="shield-check" class="h-3.5 w-3.5 text-gold-dark"></i>
                    <span id="pesanLoket">Setiap tindakan tercatat pada log aktivitas.</span>
                  </div>
                </section>

                <section id="panelBiometrik" class="hidden overflow-hidden rounded-2xl border border-border bg-white shadow-[0_2px_8px_rgba(61,40,23,0.08)]">
                  <div class="bg-bronze-dark px-7 py-6">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-cream/55">Kapasitas Ruangan Biometrik</p>
                    <div class="mt-2 flex items-center gap-4">
                      <span class="font-mono text-4xl font-bold text-gold"><span id="kapasitasSaatIni">0</span> / <span id="kapasitasMaks">8</span></span>
                      <div class="h-3 flex-1 overflow-hidden rounded-full bg-cream/15">
                        <div id="kapasitasBar" class="h-full rounded-full bg-gold transition-all" style="width:0%"></div>
                      </div>
                    </div>
                    <p class="mt-4 text-[11px] font-semibold uppercase tracking-[0.22em] text-cream/55">Rombongan Sedang Dipanggil</p>
                    <p id="biometrikNomorTampil" class="mt-1 font-mono text-4xl font-bold text-cream">—</p>
                  </div>
                  <div class="grid gap-3 px-7 py-6 md:grid-cols-3">
                    <button type="button" id="btnPanggilBiometrik" class="flex h-16 items-center justify-center gap-2.5 rounded-xl bg-gold px-2 text-sm font-bold uppercase tracking-wide text-bronze-dark shadow-[0_2px_0_#b8860b] transition-all hover:brightness-105 active:translate-y-0.5 active:shadow-none disabled:opacity-45">
                      <i data-lucide="phone-call" class="h-5 w-5 shrink-0"></i> 
                      <span class="text-left leading-tight">Panggil<br>Selanjutnya</span>
                    </button>
                    <button type="button" id="btnPanggilUlangBiometrik" disabled class="flex h-16 items-center justify-center gap-2.5 rounded-xl border-2 border-bronze bg-white px-2 text-sm font-bold uppercase tracking-wide text-bronze transition-colors hover:bg-cream disabled:cursor-not-allowed disabled:opacity-40">
                      <i data-lucide="volume-2" class="h-5 w-5 shrink-0"></i> 
                      <span class="text-left leading-tight">Panggil<br>Ulang</span>
                    </button>
                    <button type="button" id="btnSelesaiBiometrik" class="flex h-16 items-center justify-center gap-2.5 rounded-xl bg-bronze px-2 text-sm font-bold uppercase tracking-wide text-gold transition-colors hover:bg-bronze-dark">
                      <i data-lucide="log-out" class="h-5 w-5 shrink-0"></i> 
                      <span>Keluarkan</span>
                    </button>
                  </div>
                  <div class="flex items-center gap-2 border-t border-border bg-cream/50 px-7 py-3 text-[11px] text-muted-foreground">
                    <span id="pesanBiometrik">Panggilan mencakup foto murni & lemparan dari loket lain.</span>
                  </div>
                </section>

                <section class="overflow-hidden rounded-2xl border border-border bg-white shadow-[0_1px_3px_rgba(61,40,23,0.07)]">
                  <div class="flex items-center justify-between border-b border-border px-5 py-3.5">
                    <div>
                      <h2 id="judulTabelAntrean" class="text-sm font-semibold text-bronze-dark">Antrean Menunggu</h2>
                      <p id="subJudulTabelAntrean" class="text-xs text-muted-foreground">0 nomor dalam daftar tunggu</p>
                    </div>
                  </div>
                  <table class="w-full text-left text-sm">
                    <thead>
                      <tr class="text-[11px] uppercase tracking-wider text-muted-foreground">
                        <th scope="col" class="px-5 py-2.5 font-medium">Nomor</th>
                        <th scope="col" class="px-5 py-2.5 font-medium">Layanan / Rombongan</th>
                        <th scope="col" class="px-5 py-2.5 text-right font-medium">Status</th>
                      </tr>
                    </thead>
                    <tbody id="isiTabelAntrean"></tbody>
                  </table>
                </section>
              </div>

              <section class="flex flex-col rounded-2xl border border-border bg-white shadow-[0_1px_3px_rgba(61,40,23,0.07)]">
                <div class="border-b border-border px-5 py-3.5">
                  <h2 class="text-sm font-semibold text-bronze-dark">Aktivitas Terakhir</h2>
                  <p class="text-xs text-muted-foreground">Riwayat panggilan pada sesi ini</p>
                </div>
                <ul id="daftarAktivitas" class="divide-y divide-border"></ul>
              </section>
            </div>
          </div>
        </div>

        <!-- ==================== VIEW: RIWAYAT ANTREAN ==================== -->
        <div id="viewRiwayat" class="hidden flex-col gap-5">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <h1 class="text-lg font-semibold text-bronze-dark">Riwayat Antrean</h1>
              <p class="text-sm text-muted-foreground">Catatan lengkap pemanggilan nomor antrean layanan Haji dan Umrah</p>
            </div>
            <button type="button" id="btnUnduhRiwayat" class="inline-flex items-center gap-2 rounded-xl border border-border bg-white px-4 py-2.5 text-xs font-semibold text-bronze transition-colors hover:bg-cream">
              <i data-lucide="download" class="h-4 w-4 text-gold-dark"></i> Unduh CSV
            </button>
          </div>

          <section aria-label="Filter riwayat" class="rounded-2xl bg-white px-5 py-4 shadow-[0_2px_10px_rgba(61,40,23,0.06)]">
            <div class="flex flex-wrap items-end gap-4">
              <div class="flex flex-col gap-1.5">
                <label for="filterPeriode" class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Periode</label>
                <div class="relative">
                  <i data-lucide="calendar-days" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gold-dark"></i>
                  <select id="filterPeriode" class="h-11 appearance-none rounded-xl bg-cream/70 pl-10 pr-10 text-sm font-semibold text-bronze-dark focus:outline-none focus:ring-2 focus:ring-gold/50">
                    <option value="hari-ini">Hari Ini</option>
                    <option value="kemarin">Kemarin</option>
                    <option value="semua">Semua Waktu</option>
                  </select>
                  <i data-lucide="chevron-down" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-bronze-soft"></i>
                </div>
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="filterStatus" class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Status</label>
                <div class="relative">
                  <i data-lucide="filter" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gold-dark"></i>
                  <select id="filterStatus" class="h-11 appearance-none rounded-xl bg-cream/70 pl-10 pr-10 text-sm font-semibold text-bronze-dark focus:outline-none focus:ring-2 focus:ring-gold/50">
                    <option value="semua">Semua Status</option>
                    <option value="Selesai">Selesai</option>
                    <option value="Diteruskan">Diteruskan</option>
                    <option value="Dipanggil">Dipanggil</option>
                  </select>
                  <i data-lucide="chevron-down" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-bronze-soft"></i>
                </div>
              </div>
              <div class="flex min-w-[240px] flex-1 flex-col gap-1.5">
                <label for="cariNomorRiwayat" class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Cari Nomor Antrean</label>
                <div class="relative">
                  <i data-lucide="search" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-bronze-soft"></i>
                  <input type="search" id="cariNomorRiwayat" placeholder="Contoh: 012" autocomplete="off" class="h-11 w-full rounded-xl bg-cream/70 pl-10 pr-4 font-mono text-sm font-semibold text-bronze-dark placeholder:font-sans placeholder:font-medium placeholder:text-bronze-soft/70 focus:outline-none focus:ring-2 focus:ring-gold/50">
                </div>
              </div>
              <button type="button" id="btnResetFilterRiwayat" class="h-11 rounded-xl px-4 text-xs font-semibold uppercase tracking-wider text-bronze-soft transition-colors hover:bg-cream hover:text-bronze-dark">Bersihkan</button>
            </div>
          </section>

          <section class="overflow-hidden rounded-2xl bg-white shadow-[0_2px_14px_rgba(61,40,23,0.07)]">
            <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4">
              <div>
                <h2 class="text-sm font-semibold text-bronze-dark">Daftar Pemanggilan</h2>
                <p id="infoJumlahRiwayat" class="text-xs text-muted-foreground">Memuat data riwayat…</p>
              </div>
              <span class="inline-flex items-center gap-2 rounded-full bg-cream/80 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-gold-dark">
                <span class="h-1.5 w-1.5 rounded-full bg-gold"></span> Sinkron Realtime
              </span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[820px] text-left text-sm">
                <thead>
                  <tr class="bg-cream/50 text-[11px] uppercase tracking-wider text-muted-foreground">
                    <th scope="col" class="px-6 py-3 font-semibold">Waktu Panggil</th>
                    <th scope="col" class="px-6 py-3 font-semibold">Nomor Antrean</th>
                    <th scope="col" class="px-6 py-3 font-semibold">Jenis Layanan</th>
                    <th scope="col" class="px-6 py-3 font-semibold">Loket</th>
                    <th scope="col" class="px-6 py-3 text-right font-semibold">Status</th>
                  </tr>
                </thead>
                <tbody id="isiTabelRiwayat" class="divide-y divide-border/60"></tbody>
              </table>
            </div>
            <div class="flex items-center gap-2 bg-cream/40 px-6 py-3 text-[11px] text-muted-foreground">
              <i data-lucide="shield-check" class="h-3.5 w-3.5 text-gold-dark"></i>
              <span>Data riwayat bersumber dari log aktivitas dan tidak dapat diubah.</span>
            </div>
          </section>
        </div>

        <!-- ==================== VIEW: LAPORAN ==================== -->
        <div id="viewLaporan" class="hidden flex-col gap-5">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <h1 class="text-lg font-semibold text-bronze-dark">Laporan &amp; Analitik</h1>
              <p class="text-sm text-muted-foreground">Ringkasan performa pelayanan antrean Kementerian Haji dan Umrah</p>
            </div>
            <div class="relative">
              <i data-lucide="calendar-range" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gold-dark"></i>
